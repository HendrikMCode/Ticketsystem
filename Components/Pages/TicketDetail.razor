    private static readonly (string Art, string Icon, string Titel)[] Formatierungen =
    [
        ("heading", "title", "Überschrift"),
        ("bold", "format_bold", "Fett (Strg+B)"),
        ("italic", "format_italic", "Kursiv (Strg+I)"),
        ("strike", "format_strikethrough", "Durchgestrichen"),
        ("|", "", ""),
        ("code", "code", "Code im Text (Strg+E)"),
        ("codeblock", "data_object", "Codeblock (Sprache danach eintragen, z. B. sql, csharp, json)"),
        ("|", "", ""),
        ("list", "format_list_bulleted", "Liste"),
        ("numbered", "format_list_numbered", "Nummerierte Liste"),
        ("task", "checklist", "Checkliste"),
        ("quote", "format_quote", "Zitat"),
        ("link", "link", "Link (Strg+K)"),
    ];

    // ── Bearbeiten-Modus ───────────────────────────────────────
    private void StammSperren()
    {
        // Nur sperren, wenn Betreff und Nummer gültig sind – sonst kann man den Fehler nicht mehr beheben
        if (string.IsNullOrWhiteSpace(ticket!.Betreff) || string.IsNullOrWhiteSpace(ticket.Ticketnummer)
            || (fehler is not null && fehler.Contains("Ticketnummer")))
        {
            editContext!.Validate();
            return;
        }
        bearbeitenStamm = false;
    }

    private async Task BranchKopieren()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ticket!.FeatureBranch ?? "");
            kopiert = true;
            _ = Task.Delay(1500).ContinueWith(_ => InvokeAsync(() => { kopiert = false; StateHasChanged(); }));
        }
        catch { /* Zwischenablage nicht verfügbar */ }
    }

    /// <summary>Stift/Schloss-Knopf im Abschnittstitel. Ohne Aktion (neues Ticket) wird nichts angezeigt.</summary>
    private RenderFragment SperrKnopf(bool offen, Action? umschalten) => __builder =>
    {
        if (umschalten is null) return;
        <md-icon-button type="button" class="lock-btn @(offen ? "open" : null)"
                        title="@(offen ? "Fertig – wieder schützen" : "Bearbeiten")" @onclick="umschalten">
            <md-icon>@(offen ? "lock_open" : "edit")</md-icon>
        </md-icon-button>
    };

    private RenderFragment Info(string icon, string label, string? wert) => __builder =>
    {
        <div class="info-item">
            <md-icon>@icon</md-icon>
            <div>
                <dt>@label</dt>
                <dd class="@(string.IsNullOrWhiteSpace(wert) ? "leer" : null)">@(string.IsNullOrWhiteSpace(wert) ? "–" : wert)</dd>
            </div>
        </div>
    };

    private RenderFragment DatumInfo(string icon, string label, DateTime? wert, bool mitUhrzeit, string? klasse = null) => __builder =>
    {
        <div class="info-item @klasse">
            <md-icon>@icon</md-icon>
            <div>
                <dt>@label</dt>
                @if (wert is { } d)
                {
                    <dd>
                        @d.ToString(mitUhrzeit ? "ddd, dd.MM.yyyy · HH:mm" : "ddd, dd.MM.yyyy")
                        <small>@Uebersicht.Relativ(d)</small>
                    </dd>
                }
                else
                {
                    <dd class="leer">–</dd>
                }
            </div>
        </div>
    };

    // ── Hilfen ─────────────────────────────────────────────────
    private static string DatumText(DateTime d) =>
        d.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private static DateTime TextAlsDatum(string text) =>
        DateTime.TryParse(text, System.Globalization.CultureInfo.InvariantCulture,
                          System.Globalization.DateTimeStyles.None, out var d) ? d : DateTime.Now;

    private static bool IstStatusSchritt(Schritt s) => s.Text.StartsWith(StatusPraefix);

    /// <summary>Liest den Zielstatus aus „Status geändert: A → B“.</summary>
    private static TicketStatus? SchrittStatus(Schritt s)
    {
        if (!IstStatusSchritt(s)) return null;
        var ersteZeile = s.Text.Split('\n')[0];
        var ziel = ersteZeile[(ersteZeile.LastIndexOf('→') + 1)..].Trim();
        foreach (var st in Enum.GetValues<TicketStatus>())
            if (st.Anzeige() == ziel) return st;
        return null;
    }

    private static string SchrittKlasse(Schritt s)
    {
        var klasse = SchrittStatus(s) is { } st ? $"status-step {st.Css()}" : "";
        return s.Id == 0 ? klasse + " pending" : klasse;
    }

    /// <summary>Legt beim Statuswechsel sofort einen Schritt an (bzw. aktualisiert den noch ungespeicherten).</summary>
    private void StatusSchrittAktualisieren()
    {
        if (ticket!.Status == ursprungsStatus)
        {
            // zurück zum ursprünglichen Status → Schritt wieder entfernen
            if (offenerStatusSchritt is not null) ticket.Schritte.Remove(offenerStatusSchritt);
            offenerStatusSchritt = null;
            return;
        }

        var text = StatusSchrittText(ursprungsStatus, ticket.Status);
        if (offenerStatusSchritt is null)
        {
            offenerStatusSchritt = new Schritt { Datum = DateTime.Now, Text = text };
            ticket.Schritte.Add(offenerStatusSchritt);
        }
        else
        {
            offenerStatusSchritt.Text = text;
            offenerStatusSchritt.Datum = DateTime.Now;
        }
        Aendern(nameof(Ticket.Schritte));
    }

    // ── Automatiken ────────────────────────────────────────────
    private void StatusSetzen(TicketStatus s)
    {
        ticket!.Status = s;
        if (s == TicketStatus.Wartend && ticket.WartetSeit is null) ticket.WartetSeit = Jetzt;
        if (s == TicketStatus.Erledigt)
        {
            ticket.Erledigt = true;
            ticket.ErledigtAm ??= Jetzt;
        }
        else if (ticket.Erledigt)
        {
            ticket.Erledigt = false;
            ticket.ErledigtAm = null;
        }
        Aendern(nameof(Ticket.Status));
        StatusSchrittAktualisieren();
    }

    private void ErledigtGeaendert()
    {
        if (ticket!.Erledigt)
        {
            ticket.Status = TicketStatus.Erledigt;
            ticket.ErledigtAm ??= Jetzt;
        }
        else
        {
            ticket.ErledigtAm = null;
            if (ticket.Status == TicketStatus.Erledigt) ticket.Status = TicketStatus.InArbeit;
        }
        StatusSchrittAktualisieren();
    }

    private void Setzen(Action a)
    {
        a();
        Aendern(nameof(Ticket.GeaendertAm));
    }

    private void Aendern(string feld) =>
        editContext!.NotifyFieldChanged(new FieldIdentifier(ticket!, feld));

    private static DateTime NaechsterMontag()
    {
        var d = DateTime.Today.AddDays(1);
        while (d.DayOfWeek != DayOfWeek.Monday) d = d.AddDays(1);
        return d.AddHours(9);
    }

    private async Task Loeschen()
    {
        autoSpeichernCts?.Cancel();
        await Service.LoeschenAsync(ticket!.Id);
        editContext!.MarkAsUnmodified();
        Nav.NavigateTo("");
    }

    // ── Schritte ───────────────────────────────────────────────
    private async Task SchrittHinzufuegen()
    {
        if (string.IsNullOrWhiteSpace(neuerSchrittText)) return;

        if (IstNeu)
        {
            // Bei neuen Tickets erst im Speicher halten – wird mit dem Ticket gespeichert.
            ticket!.Schritte.Add(new Schritt { Datum = TextAlsDatum(neuerSchrittDatumText), Text = neuerSchrittText.Trim() });
            Aendern(nameof(Ticket.Schritte));
        }
        else
        {
            var s = await Service.SchrittHinzufuegenAsync(ticket!.Id, TextAlsDatum(neuerSchrittDatumText), neuerSchrittText);
            ticket.Schritte.Add(s);
        }

        neuerSchrittText = "";
        neuerSchrittDatumText = DatumText(Jetzt);
    }

    private async Task SchrittTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await SchrittHinzufuegen();
    }

    private async Task SchrittLoeschen(Schritt s)
    {
        if (!IstNeu && s.Id != 0) await Service.SchrittLoeschenAsync(s.Id);
        if (s == offenerStatusSchritt) offenerStatusSchritt = null;
        if (s == letzterStatusSchritt) letzterStatusSchritt = null;
        if (s == bearbeiteterSchritt) bearbeiteterSchritt = null;
        ticket!.Schritte.Remove(s);
    }

    private void SchrittBearbeiten(Schritt s)
    {
        bearbeiteterSchritt = s;
        bearbeitenText = s.Text;
        bearbeitenDatumText = DatumText(s.Datum);
    }

    private void BearbeitenAbbrechen() => bearbeiteterSchritt = null;

    private async Task BearbeitenSpeichern()
    {
        var s = bearbeiteterSchritt;
        if (s is null || string.IsNullOrWhiteSpace(bearbeitenText)) return;
        var datum = TextAlsDatum(bearbeitenDatumText);
        var text = bearbeitenText.Trim();

        if (s.Id != 0)
        {
            await Service.SchrittAendernAsync(s.Id, datum, text);
        }
        else
        {
            Aendern(nameof(Ticket.Schritte));   // gehört zu einem noch nicht angelegten Ticket
        }
        s.Datum = datum;
        s.Text = text;
        bearbeiteterSchritt = null;
    }

    private async Task BearbeitenTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await BearbeitenSpeichern();
        else if (e.Key == "Escape") BearbeitenAbbrechen();
    }

    // ── Tasks (werden sofort gespeichert) ──────────────────────
    // Die Service-Methoden liefern den neuen Wert von „Keine Task mehr“ – den übernehmen wir,
    // ohne ihn als Änderung zu markieren (sonst würde das Auto-Speichern ihn wieder überschreiben).
    private async Task TaskTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(neuerTaskTitel) || IstNeu) return;
        var titel = neuerTaskTitel;
        neuerTaskTitel = "";
        await TaskAktion(async () =>
        {
            var (aufgabe, keineTaskMehr) = await Service.AufgabeHinzufuegenAsync(ticket!.Id, titel);
            ticket.Aufgaben.Add(aufgabe);
            return keineTaskMehr;
        });
    }

    private Task AufgabeStatusSetzen(Aufgabe a, AufgabeStatus ziel) => TaskAktion(async () =>
    {
        a.Status = ziel;
        return await Service.AufgabeAendernAsync(a);
    });

    private Task AufgabeTitelAendern(Aufgabe a, string? titel)
    {
        if (string.IsNullOrWhiteSpace(titel) || titel.Trim() == a.Titel) return Task.CompletedTask;
        return TaskAktion(async () =>
        {
            a.Titel = titel.Trim();
            return await Service.AufgabeAendernAsync(a);
        });
    }

    private Task AufgabeStundenAendern(Aufgabe a, string? text) => TaskAktion(async () =>
    {
        a.RestaufwandStunden = Taskboard.StundenLesen(text);
        return await Service.AufgabeAendernAsync(a);
    });

    private Task AufgabeLoeschen(Aufgabe a) => TaskAktion(async () =>
    {
        var keineTaskMehr = await Service.AufgabeLoeschenAsync(a.Id);
        ticket!.Aufgaben.Remove(a);
        return keineTaskMehr;
    });

    private async Task AufgabeUmsortieren(Aufgabe ziel)
    {
        var quelle = gezogeneAufgabe;
        gezogeneAufgabe = null;
        ueberAufgabe = null;
        if (quelle is null || quelle == ziel) return;

        var liste = ticket!.Aufgaben.OrderBy(x => x.Reihenfolge).ToList();
        var nachUnten = liste.IndexOf(quelle) < liste.IndexOf(ziel);
        liste.Remove(quelle);
        liste.Insert(liste.IndexOf(ziel) + (nachUnten ? 1 : 0), quelle);
        for (var i = 0; i < liste.Count; i++) liste[i].Reihenfolge = i + 1;
        await Service.AufgabenSortierenAsync(ticket.Id, liste.Select(x => x.Id).ToList());
    }

    private async Task TaskAktion(Func<Task<bool>> aktion)
    {
        try
        {
            var keineTaskMehr = await aktion();
            ticket!.KeineTaskMehr = keineTaskMehr;
        }
        catch (Exception ex)
        {
            fehler = "Task konnte nicht gespeichert werden: " + ex.Message;
        }
    }

    // ── Seite verlassen: vorher speichern ──────────────────────
    private async Task VorNavigation(LocationChangingContext ctx)
    {
        if (ticket is not null && !IstNeu && ctx.TargetLocation.EndsWith($"tickets/{ticket.Id}")) return;
        if (editContext?.IsModified() != true) return;

        autoSpeichernCts?.Cancel();
        if (await SpeichernWennNoetig()) return;

        var ok = await JS.InvokeAsync<bool>("confirm",
            "Die letzten Änderungen konnten nicht gespeichert werden (z. B. fehlt der Betreff). Trotzdem verlassen?");
        if (!ok) ctx.PreventNavigation();
    }

    public void Dispose()
    {
        autoSpeichernCts?.Cancel();
        if (editContext is not null) editContext.OnFieldChanged -= FeldGeaendert;
    }
}
