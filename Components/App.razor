<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // Theme vor dem ersten Rendern setzen (kein Aufblitzen)
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.dataset.theme = t;
            } catch (e) { }
        })();
        window.ticketsystem = {
            toggleTheme: function () {
                var d = document.documentElement;
                var t = d.dataset.theme === 'dark' ? 'light' : 'dark';
                d.dataset.theme = t;
                try { localStorage.setItem('theme', t); } catch (e) { }
                return t;
            },
            theme: function () { return document.documentElement.dataset.theme; }
        };
        // Drag & Drop (Board/Taskboard): manche Browser starten das Ziehen nur mit Daten im dataTransfer
        document.addEventListener('dragstart', function (e) {
            var el = e.target && e.target.closest ? e.target.closest('[data-drag]') : null;
            if (el && e.dataTransfer) {
                e.dataTransfer.effectAllowed = 'move';
                try { e.dataTransfer.setData('text/plain', el.getAttribute('data-drag') || ''); } catch (x) { }
            }
        });
    </script>
    <meta name="theme-color" content="#f8fafd" />
    @* Schriften & Symbole von Google Fonts, Material-3-Komponenten (Material Web) von jsDelivr *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,300..700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@@material/web@2.5.0/all.js/+esm"></script>
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Ticketsystem.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    @* Syntax-Hervorhebung für Codeblöcke (highlight.js) *@
    <script defer src="https://cdn.jsdelivr.net/npm/@@highlightjs/cdn-assets@11.12.0/highlight.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@@highlightjs/cdn-assets@11.12.0/languages/powershell.min.js"></script>
    <script src="@Assets["bilder.js"]"></script>
    <script src="@Assets["editor.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
